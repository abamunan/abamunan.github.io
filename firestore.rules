rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Garments Accounts (shared partner ledger) ──────────────────────
    // Only the 3 verified partner accounts can touch anything under
    // /garments/... (see isGarmentsPartner below). On top of that:
    //   • Sales / Expenses / Stock / Accounts entries: only the person who
    //     entered an entry can edit or delete it. Exception: on a SALE, any
    //     partner may change ONLY received / receivedDate (Money Received).
    //     Keep that list in sync with SHARED_FIELDS in garments-accounts.html.
    //   • History log: append-only — nobody can edit or delete it.
    //   • Bin: deleted entries are kept forever; the only allowed change is
    //     marking one as restored.
    //
    // NOTE: the old catch-all `match /garments/{rest=**}` was removed on
    // purpose. Firestore ORs every matching rule, so leaving it in place
    // would let any partner bypass the stricter rules below.

    // settings doc (garments/settings) and any other document sitting
    // directly under /garments — same access as before
    match /garments/{docId} {
      allow read, write: if isGarmentsPartner();
    }

    // Sales / Expenses / Stock / Accounts  (garments/{col}/items/{id})
    match /garments/{col}/items/{id} {
      allow read:   if isGarmentsPartner() && isLedger(col);
      allow create: if isGarmentsPartner() && isLedger(col)
                    && request.resource.data.get('enteredEmail', '').lower()
                       == request.auth.token.email.lower();
      allow update: if isGarmentsPartner() && isLedger(col) && (
        isOwnerOrLegacy()
        && request.resource.data.get('enteredEmail', '')
           == resource.data.get('enteredEmail', '')
        || (col == 'sales'
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['received', 'receivedDate', 'editedBy']))
      );
      allow delete: if isGarmentsPartner() && isLedger(col) && isOwnerOrLegacy()
                    && resource.data.get('enteredEmail', '') != '';
    }

    // History log — append-only
    match /garments/log/items/{id} {
      allow read:   if isGarmentsPartner();
      allow create: if isGarmentsPartner()
                    && request.resource.data.email == request.auth.token.email.lower();
      allow update, delete: if false;
    }

    // Bin — deleted entries, kept forever
    match /garments/bin/items/{id} {
      allow read:   if isGarmentsPartner();
      allow create: if isGarmentsPartner()
                    && request.resource.data.deletedEmail == request.auth.token.email.lower();
      allow update: if isGarmentsPartner()
                    && !('restoredAt' in resource.data)
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['restoredAt', 'restoredBy']);
      allow delete: if false;
    }

    // secrets — only the verified site owner can read; nobody can write
    // from the client (add/change secrets in the Firebase console).
    // part1.html reads secrets/privateDrive, so the doc ID is NOT a uid.
    match /secrets/{docId} {
      allow read: if isSiteOwner();
      allow write: if false;
    }

    // users — each signed-in user can only touch THEIR OWN subtree, and only
    // the collections the site really uses. The old catch-all
    // `match /users/{uid}/{rest=**}` was removed on purpose: Firestore ORs every
    // matching rule, so leaving it in place would make the stricter Money Tracker
    // rules below useless (anything they refuse, the catch-all would allow).
    // Anything not listed here is now denied. If you add a new per-user
    // collection to the site, add a `match` for it in this block.
    //
    // Collections in use (grep for 'users', uid):
    //   moneytracker, moneytracker_meta   apps/money        (checked below)
    //   healthtracker, healthtracker_meta apps/health
    //   english_days, english_meta        english-tracker.html
    //   typemaster                        TypeMaster.html
    //   duzoology                         du-zoology-cg-planner.html
    //   profile                           auth.js
    match /users/{uid}/healthtracker/{id}       { allow read, write: if isUser(uid); }
    match /users/{uid}/healthtracker_meta/{id}  { allow read, write: if isUser(uid); }
    match /users/{uid}/english_days/{id}        { allow read, write: if isUser(uid); }
    match /users/{uid}/english_meta/{id}        { allow read, write: if isUser(uid); }
    match /users/{uid}/typemaster/{id}          { allow read, write: if isUser(uid); }
    match /users/{uid}/duzoology/{id}           { allow read, write: if isUser(uid); }
    match /users/{uid}/profile/{id}             { allow read, write: if isUser(uid); }

    // Money Tracker — one document per day, e.g. moneytracker/2026_10_7.
    // Writes must look like a day document the app produces: the id is a date,
    // `updatedAt` is a number (the incremental sync queries on it), `entries`
    // is a list, `locked` a bool, and the document stays a sane size. Category
    // amounts are flat fields named after the category id, so other keys are free.
    match /users/{uid}/moneytracker/{dayId} {
      allow read, delete: if isUser(uid);
      allow create, update: if isUser(uid)
                            && dayId.matches('^[0-9]{4}_[0-9]{1,2}_[0-9]{1,2}$')
                            && isMoneyDay(request.resource.data);
    }

    // Money Tracker — the four shared documents. No other id is accepted.
    match /users/{uid}/moneytracker_meta/{docId} {
      allow read, delete: if isUser(uid);
      allow create, update: if isUser(uid)
                            && docId in ['settings', 'ledger', 'debts', 'deleted_days']
                            && request.resource.data.keys().size() <= 60;
    }

    // passwordResetCooldowns — this flow runs BEFORE login, so request.auth
    // is always null here and we can't tie access to a uid. These rules
    // enforce the cooldown at the database level instead of trusting
    // the client:
    //   - anyone can read (needed to check "can I request a reset yet?")
    //   - a doc can only be created/updated with ONE field, lastRequestedAt,
    //     and its value must equal request.time (the server's clock) — so
    //     nobody can forge a fake past/future timestamp
    //   - an update is only allowed once real server time has moved past
    //     the previous timestamp + COOLDOWN_SECONDS — so no one, including
    //     an attacker, can write faster than the cooldown allows
    //   - delete is blocked entirely, so a cooldown can't be erased early
    //
    // Set COOLDOWN_SECONDS (currently 60) to match whatever cooldown your
    // app logic actually uses.
    match /passwordResetCooldowns/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['lastRequestedAt'])
                    && request.resource.data.lastRequestedAt == request.time;
      allow update: if request.resource.data.keys().hasOnly(['lastRequestedAt'])
                    && request.resource.data.lastRequestedAt == request.time
                    && request.time > resource.data.lastRequestedAt + duration.value(60, 's');
      allow delete: if false;
    }

    // ── diaryEntries ─────────────────────────────────────────────────
    // REPLACES the previous version of this block. The old `update` rule
    // only checked who owned the EXISTING document (resource.data.userId)
    // and never checked the userId being WRITTEN (request.resource.data.
    // userId) — so a signed-in owner could update their own entry and
    // silently reassign it to another user's UID. This version checks
    // ownership on both sides of the write, and validates the fields the
    // app depends on so malformed documents can't get written either.
    match /diaryEntries/{entryId} {
      // `resource == null` lets a read of a MISSING doc return "not found" instead of
      // permission-denied (the app's "deleted elsewhere" check depends on this).
      allow read: if isSignedIn() && (resource == null || isOwner(resource.data.userId));
      allow create: if isSignedIn()
                    && isVerifiedEmail()
                    && isOwner(request.resource.data.userId)
                    && hasValidDiaryShape(request.resource.data);
      allow update: if isSignedIn()
                    && isVerifiedEmail()
                    && isOwner(resource.data.userId)
                    && isOwner(request.resource.data.userId)
                    && hasValidDiaryShape(request.resource.data);
      allow delete: if isSignedIn() && (resource == null || isOwner(resource.data.userId));
    }

    // ── Helpers ──────────────────────────────────────────────────────
    // isSignedIn / isOwner / hasValidDiaryShape / isValidDiarySections are
    // used by diaryEntries above. isGarmentsPartner, isLedger and
    // isOwnerOrLegacy are used by /garments.
    function isSignedIn() {
      return request.auth != null;
    }

    // The site owner (same email as owner.js). Must be verified.
    function isSiteOwner() {
      return request.auth != null
          && request.auth.token.email_verified == true
          && request.auth.token.email.lower() == 'allmunanabdullah@gmail.com';
    }

    function isUser(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // A Money Tracker day document (see the /moneytracker match above).
    function isMoneyDay(data) {
      return data.keys().size() <= 400
        && data.get('updatedAt', 0) is number
        && data.get('entries', []) is list
        && data.get('entries', []).size() <= 1000
        && data.get('locked', false) is bool;
    }

    function isOwner(userId) {
      return userId == request.auth.uid;
    }

    // ── the 3 partners ───────────────────────────────────────────────
    // Emails must be lowercase here. email_verified blocks look-alike or
    // unverified accounts.
    function isGarmentsPartner() {
      return request.auth != null
          && request.auth.token.email_verified == true
          && request.auth.token.email.lower() in [
               'allmunanabdullah@gmail.com',
               'maitrariti@gmail.com',
               'jeetm6863@gmail.com'
             ];
    }

    // ── NEW helpers for the garments ledger ──────────────────────────
    function isLedger(col) {
      return col in ['sales', 'expenses', 'stock', 'capital'];
    }

    // An entry is editable/deletable by the partner who entered it.
    // Legacy entries without an owner are not editable or deletable through
    // the client; they must be migrated by an administrative process.
    function isOwnerOrLegacy() {
      return resource.data.get('enteredEmail', '').lower()
          == request.auth.token.email.lower();
    }

    function isVerifiedEmail() {
      return request.auth.token.email_verified == true;
    }

    // hasOnly() lists every field the diary writes. mood / tags / pinned / starred are OPTIONAL (written only when set).
    function hasValidDiaryShape(data) {
      return data.keys().hasAll(['userId', 'datetime', 'sections'])
        && data.keys().hasOnly(['userId', 'datetime', 'sections', 'createdAt', 'updatedAt', 'mood', 'tags', 'pinned', 'starred'])
        && (!('mood' in data) || (data.mood is int && data.mood >= 1 && data.mood <= 5))
        && (!('pinned' in data) || data.pinned is bool)
        && (!('starred' in data) || data.starred is bool)
        && (!('tags' in data) || isValidDiaryTags(data.tags))
        && data.userId is string
        && data.datetime is string
        && data.datetime.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}$')
        && data.sections is list
        && data.sections.size() >= 1
        && data.sections.size() <= 10
        && isValidDiarySections(data.sections);
    }

    // One section: exactly {title, content}, both strings, length-capped
    // (30000 chars x 10 sections stays under Firestore's 1 MiB document limit even for Bangla text).
    function isValidDiarySection(s) {
      return s is map
        && s.keys().hasAll(['title', 'content'])
        && s.keys().hasOnly(['title', 'content'])
        && s.title is string
        && s.content is string
        && s.title.size() <= 200
        && s.content.size() <= 30000;
    }

    // Up to 10 tags, each a 1..30 char string (explicit indexes: rules have no loops).
    function isValidDiaryTag(tags, i) {
      return tags.size() <= i || (tags[i] is string && tags[i].size() >= 1 && tags[i].size() <= 30);
    }

    function isValidDiaryTags(tags) {
      return tags is list && tags.size() <= 10
        && isValidDiaryTag(tags, 0) && isValidDiaryTag(tags, 1) && isValidDiaryTag(tags, 2)
        && isValidDiaryTag(tags, 3) && isValidDiaryTag(tags, 4) && isValidDiaryTag(tags, 5)
        && isValidDiaryTag(tags, 6) && isValidDiaryTag(tags, 7) && isValidDiaryTag(tags, 8)
        && isValidDiaryTag(tags, 9);
    }

    // Rules have no loops, so every possible index (max 10 sections) is checked explicitly.
    function isValidDiarySections(sections) {
      return isValidDiarySection(sections[0])
        && (sections.size() <= 1 || isValidDiarySection(sections[1]))
        && (sections.size() <= 2 || isValidDiarySection(sections[2]))
        && (sections.size() <= 3 || isValidDiarySection(sections[3]))
        && (sections.size() <= 4 || isValidDiarySection(sections[4]))
        && (sections.size() <= 5 || isValidDiarySection(sections[5]))
        && (sections.size() <= 6 || isValidDiarySection(sections[6]))
        && (sections.size() <= 7 || isValidDiarySection(sections[7]))
        && (sections.size() <= 8 || isValidDiarySection(sections[8]))
        && (sections.size() <= 9 || isValidDiarySection(sections[9]));
    }

  }
}
